# openai or groq. Groq uses the OpenAI-compatible chat API.
LLM_PROVIDER=groq

# Used when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_TEMPERATURE=0.7

# Used when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# SQLite database file, relative to the project root unless absolute.
DATABASE_PATH=data/keel.db
